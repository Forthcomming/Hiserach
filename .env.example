# ── 数据层 ────────────────────────────────────────────────────────────────
# supabase = 生产路径（规格锁定的持久化服务）
# memory   = 本地联调 / 单元测试适配器，仅用于开发，不作为演示数据来源
DATA_BACKEND=memory

# 仅服务端，绝不进入客户端 bundle，也不要提交真实值
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 经验数据夹具路径（仅 memory 后端使用；正式样本须离线校验后入库）
SEED_FIXTURE_PATH=./data/fixtures.json

# ── 模型层 ────────────────────────────────────────────────────────────────
# 未配置时所有模型节点走模板兜底，链路仍可完整跑通（规格 6.8 / AC-10）
# 注意：LLM_PROVIDER 仅作标注，代码不读取；实际由 LLM_BASE_URL + LLM_MODEL 决定。
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
# OpenAI 兼容地址，不带 /v1 后缀；DeepSeek 官方为 https://api.deepseek.com
LLM_BASE_URL=
# 当前官方模型 ID：deepseek-flash（便宜快档）/ deepseek-v4-pro。
# 旧的 deepseek-chat、deepseek-reasoner 已于 2026-07-24 退役，不要再填。
LLM_MODEL=
# 模型调用超时（毫秒），规格要求 15s
LLM_TIMEOUT_MS=15000

# ── Vercel 生产部署 ───────────────────────────────────────────────────────
# 以下值在 Vercel 项目 Settings → Environment Variables 里设置，绝不写进文件、绝不提交。
#   DATA_BACKEND=supabase
#   SUPABASE_URL=https://<project>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=<service_role>
#   LLM_API_KEY=<deepseek key>
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
#   ALLOWED_SOURCE_HOSTS=www.xiaohongshu.com,xiaohongshu.com
# 本地开发保持 DATA_BACKEND=memory；生产禁用 memory（进程内单例在 serverless 会丢会话）。
# 初始化：先在 Supabase SQL Editor 执行 supabase/migrations/0001_init.sql，再跑 npm run db:seed。

# ── 安全 ──────────────────────────────────────────────────────────────────
# source_url 域名白名单，逗号分隔
ALLOWED_SOURCE_HOSTS=www.xiaohongshu.com,xiaohongshu.com
